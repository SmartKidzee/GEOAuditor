# Git Ignore Configuration for GEOAuditor

# Python virtual environment
backend/venv/
venv/
ENV/
env/
.venv/

# Environment files and API keys (CRITICAL: Never commit secrets)
.env
.env.*
!.env.example
!.env.production.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env.local
frontend/.env*.local

# SQLite Database files
*.db
*.sqlite3
backend/*.db
backend/*.sqlite3

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
backend/__pycache__/
backend/app/__pycache__/
backend/tests/__pycache__/

# Node.js & Next.js build artifacts
node_modules/
frontend/node_modules/
.next/
frontend/.next/
frontend/out/

# Operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
