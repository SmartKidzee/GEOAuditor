# GEOAuditor Backend Environment Variables Example
# Copy this file to .env and fill in your Gemini API key:
# cp .env.example .env

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
DATABASE_PATH=./geoauditor.db

# --- AI probe tuning (all optional) ---
# Repeated runs of the English organic-discovery probe (1-8). More runs = a steadier
# mention rate but more API calls. Free-tier users may prefer 2-3.
GEO_PROBE_RUNS=3
# Runs per Indic language (Hindi, Kannada)
GEO_INDIC_RUNS=1
# Parallel Gemini calls (lower this if you hit rate limits)
GEO_PROBE_CONCURRENCY=2
# Sampling temperature for the organic probes
GEO_PROBE_TEMPERATURE=0.8
# Per-call timeout in seconds
GEO_CALL_TIMEOUT_SECONDS=45

# Optional: route Gemini calls through a proxy / gateway (leave empty for Google's default endpoint)
GEMINI_BASE_URL=
